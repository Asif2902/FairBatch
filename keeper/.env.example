# ==============================================================================
# FairBatch Optional Keeper & Relayer Configuration (.env.example)
# Copy to `keeper/.env` and fill in a DEDICATED LOW-BALANCE Sepolia wallet key.
# NEVER commit `keeper/.env` or a real private key!
# ==============================================================================

# Dedicated low-balance Sepolia wallet key (0x + 64 hex chars). Leave empty in git.
KEEPER_PRIVATE_KEY=

# Optional primary Sepolia RPC override (falls back to config/deployment.json + config/networks.json)
KEEPER_RPC_URL=

# Polling interval in milliseconds (default: 2000ms)
KEEPER_POLL_MS=2000

# Grace period (seconds) after revealDeadline before keeper settles a non-empty round (default: 5s)
KEEPER_GRACE_SECONDS=5

# Minimum minutes between settling empty Ready batches (default: 0 = settle empty rounds after the same grace period)
KEEPER_EMPTY_ROUND_MINUTES=0

# Enable permissionless slashing of expired unrevealed commitments (default: true)
KEEPER_SLASH=true

# Grace period (seconds) after revealDeadline before slashing expired unrevealed commits (default: 60s)
KEEPER_SLASH_GRACE_SECONDS=60

# Safety guards
KEEPER_MIN_BALANCE_ETH=0.005
KEEPER_MAX_GAS_PRICE_GWEI=50
KEEPER_SETTLE_GAS_LIMIT=12000000
KEEPER_SLASH_GAS_LIMIT=600000

# HTTP health & optional intent relayer server
KEEPER_HOST=0.0.0.0
KEEPER_PORT=3002
KEEPER_CORS_ORIGIN=http://localhost:5173

# Optional EIP-712 intent relayer (POST /relay/intent)
KEEPER_RELAY_ENABLED=true
KEEPER_RELAY_GRACE_SECONDS=5
KEEPER_RELAY_DEADLINE_BUFFER_SECONDS=30
KEEPER_RELAY_MAX_QUEUE=16
KEEPER_RELAY_RATE_LIMIT_PER_IP=12
KEEPER_RELAY_RATE_LIMIT_PER_TRADER=6
KEEPER_RELAY_RATE_WINDOW_MS=60000
KEEPER_RELAY_GAS_LIMIT=1500000

# Dry-run mode (true = log actions without broadcasting transactions)
KEEPER_DRY_RUN=false
