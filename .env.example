# ==============================================================================
# FairBatch — Environment & Sepolia Deployment Template (.env.example)
# Copy to `.env` (`cp .env.example .env`) and set `DEPLOYER_PRIVATE_KEY` before
# running `scripts/deploy_sepolia.ps1`. NEVER commit real private keys!
# ==============================================================================

# Target Network & Cancun-Compatible Chain ID
# Supported: sepolia (11155111) | hoodi (560048) | mainnet (1) | anvil (31337)
NETWORK=sepolia
CHAIN_ID=11155111

# Ethereum Sepolia JSON-RPC Endpoint (works out of the box; replace with your
# own Alchemy / Infura / QuickNode Sepolia HTTPS URL if preferred)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# REQUIRED FOR SEPOLIA DEPLOY: Paste your funded Sepolia private key (0x...) here
DEPLOYER_PRIVATE_KEY=

# Optional: Solver / Keeper private key for automated `settleBatch()` submission
# (defaults to DEPLOYER_PRIVATE_KEY if left empty)
SOLVER_PRIVATE_KEY=

# Token Provisioning Mode for `scripts/deploy_sepolia.ps1`:
#   - true  : Deploys fresh 18-decimal `fWETH` + 6-decimal `fUSDC` (`MockERC20`) from
#             `./out/MockERC20.bin` and seeds `100 fWETH` + `300,000 fUSDC` reserves.
#   - false : Uses existing ERC-20 contracts set in `BASE_TOKEN_ADDRESS` and
#             `QUOTE_TOKEN_ADDRESS` below.
#             Canonical Sepolia Reference Tokens (if DEPLOY_TEST_TOKENS=false):
#               Sepolia WETH9 (18 decimals) : 0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
#               Circle USDC   (6 decimals)  : 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
#             Canonical Mainnet Reference Tokens (Chain ID 1):
#               Mainnet WETH9 (18 decimals) : 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
#               Circle USDC   (6 decimals)  : 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
DEPLOY_TEST_TOKENS=true

# FairBatch Market Initialization Parameters
BASE_DECIMALS=18
QUOTE_DECIMALS=6
COMMIT_WINDOW_SECS=60
REVEAL_WINDOW_SECS=60
MIN_BOND_WEI=100000000000000
INITIAL_RESERVE_BASE=100
INITIAL_RESERVE_QUOTE=300000

# Deployed Contract Addresses (auto-populated by `scripts/deploy_sepolia.ps1`;
# while `0x0000...`, `fairbatch-backend` runs in deterministic `local_engine` mode)
FAIRBATCH_ADDRESS=0x0000000000000000000000000000000000000000
BASE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
QUOTE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional Etherscan API key for explorer metadata lookup
ETHERSCAN_API_KEY=

# Rust Axum Solver & Simulation Server Bind Address
HOST=127.0.0.1
PORT=3001
