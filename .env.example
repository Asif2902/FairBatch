# ==============================================================================
# FairBatch — Optional Root Environment Template (.env.example)
#
# NOTE: You do NOT need a `.env` file to run the web app (`frontend/`), run
# tests (`fe test`, `npm test`, `cargo test`), or verify live Sepolia contracts.
# All deployed Sepolia contract addresses live in `config/deployment.json`.
#
# Copy to `.env` (git-ignored) ONLY if you plan to redeploy contracts to
# Ethereum Sepolia via `scripts/deploy_sepolia.ps1` or override the RPC URL
# used by `scripts/verify_deployed_bytecode.mjs`.
#
# NEVER commit `.env` or any real private key!
# ==============================================================================

# --- Optional: Sepolia JSON-RPC endpoint (chainId 11155111) -------------------
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Redeploy ONLY (`scripts/deploy_sepolia.ps1`) -----------------------------
# Dedicated Sepolia deployer wallet key (0x + 64 hex chars). Leave empty in git.
DEPLOYER_PRIVATE_KEY=

# Market window & commit-reveal parameters (matches config/deployment.json)
COMMIT_WINDOW_SECS=60
REVEAL_WINDOW_SECS=60
MIN_BOND_WEI=100000000000000

# Standalone Sepolia Faucet parameters (1 fWETH + 100 fUSDC per 12h)
FAUCET_FUND_BASE=2000
FAUCET_FUND_QUOTE=1000000
FAUCET_CLAIM_BASE=1
FAUCET_CLAIM_QUOTE=100
FAUCET_COOLDOWN_SECS=43200
