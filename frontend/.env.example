# ==============================================================================
# FairBatch Frontend — Optional Environment Template (frontend/.env.example)
#
# NOTE: No `.env` file is required to run the FairBatch web app. All live
# Ethereum Sepolia contract addresses and RPC endpoints are loaded directly from
# `config/deployment.json` and `config/networks.json`.
#
# Copy to `frontend/.env.local` (git-ignored) ONLY if you want to connect the
# UI to an optional settlement keeper / EIP-712 intent relayer (`keeper/`).
# ==============================================================================

# Optional Ethereum Sepolia Alchemy RPC (used for pre-flight simulation, gas estimation,
# reads, logs & receipt confirmation; connected wallet signs locally).
# Paste ONLY your Alchemy API key (builds https://eth-sepolia.g.alchemy.com/v2/<KEY>):
VITE_ALCHEMY_API_KEY=
# Or provide a full Sepolia RPC URL (e.g. https://eth-sepolia.g.alchemy.com/v2/<KEY>):
VITE_RPC_URL=

# Optional keeper & intent relayer base URL (leave unset to run 100% client-only):
#   - Local dev with `keeper/` running: http://localhost:3002
#   - Production behind Caddy (`deploy.sh`): /keeper
VITE_KEEPER_URL=
