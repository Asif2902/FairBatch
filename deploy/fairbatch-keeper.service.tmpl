[Unit]
Description=FairBatch Optional Settlement Keeper & EIP-712 Intent Relayer (Sepolia)
Documentation=https://github.com/Asif2902/FairBatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__CURRENT_LINK__/keeper
EnvironmentFile=__ENV_FILE__
ExecStart=__KEEPER_EXEC__
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
SyslogIdentifier=fairbatch-keeper
StandardOutput=journal
StandardError=journal

# Hardening — least privilege, read-only root, loopback-only network service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=__STATE_DIR__

[Install]
WantedBy=multi-user.target
