# FairBatch Caddy configuration — HTTPS Domain mode (__DOMAIN__)
# Generated by deploy.sh (automatic Let's Encrypt TLS + same-origin /keeper/* proxy + SPA fallback).
__WWW_BLOCK__
__DOMAIN__ {
	encode zstd gzip

	# Basic security headers + HSTS (no restrictive CSP that could break injected EIP-1193 wallets or user RPCs)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Same-origin reverse proxy to loopback-only keeper (/keeper/* -> 127.0.0.1:__KEEPER_PORT__/*)
	handle_path /keeper/* {
		reverse_proxy 127.0.0.1:__KEEPER_PORT__ {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Static frontend with SPA fallback (/docs, etc.)
	handle {
		root * __FRONTEND_ROOT__

		# Immutable long cache for Vite content-hashed assets
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Always revalidate HTML entrypoints so new releases appear immediately
		@html {
			path / /index.html /docs /docs/*
		}
		header @html Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
