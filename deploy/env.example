# ==============================================================================
# FairBatch Production Server Environment Template (deploy/env.example)
#
# Installed by ./deploy.sh to: /etc/fairbatch/fairbatch.env
# Permissions enforced:        chmod 600, owned by fairbatch:fairbatch
# NEVER place real secrets inside the git repository.
#
# Lines annotated with `# REQUIRED` define the mandatory variables validated by
# deploy.sh on every run (preflight, deploy, update, dry-run).
# ==============================================================================

# --- REQUIRED: Dedicated low-balance Sepolia keeper wallet --------------------
# Must be 0x + 64 hex chars. Generate a fresh wallet (e.g. `cast wallet new` or
# `node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"`).
# Do NOT reuse a personal wallet, mainnet wallet, or Anvil/Hardhat default key.
KEEPER_PRIVATE_KEY= # REQUIRED

# --- REQUIRED: Ethereum Sepolia JSON-RPC endpoint (chainId 11155111) ----------
KEEPER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com # REQUIRED

# --- REQUIRED: Loopback bind host & port (proxied by Caddy at /keeper/*) ------
KEEPER_HOST=127.0.0.1 # REQUIRED
KEEPER_PORT=3002 # REQUIRED

# --- REQUIRED: Settlement & slashing timing policies --------------------------
KEEPER_GRACE_SECONDS=5 # REQUIRED
KEEPER_EMPTY_ROUND_MINUTES=0 # REQUIRED
KEEPER_SLASH=true # REQUIRED
KEEPER_SLASH_GRACE_SECONDS=60 # REQUIRED

# --- REQUIRED: Safety caps ----------------------------------------------------
KEEPER_MIN_BALANCE_ETH=0.005 # REQUIRED
KEEPER_MAX_GAS_PRICE_GWEI=50 # REQUIRED
KEEPER_SETTLE_GAS_LIMIT=12000000 # REQUIRED
KEEPER_SLASH_GAS_LIMIT=600000 # REQUIRED

# --- REQUIRED: Optional EIP-712 intent relayer settings -----------------------
KEEPER_RELAY_ENABLED=true # REQUIRED
KEEPER_RELAY_GRACE_SECONDS=5 # REQUIRED
KEEPER_RELAY_GAS_LIMIT=1500000 # REQUIRED

# --- OPTIONAL: Tuning & preflight mainnet check -------------------------------
KEEPER_POLL_MS=2000
KEEPER_RELAY_DEADLINE_BUFFER_SECONDS=30
KEEPER_RELAY_MAX_QUEUE=16
KEEPER_RELAY_RATE_LIMIT_PER_IP=12
KEEPER_RELAY_RATE_LIMIT_PER_TRADER=6
KEEPER_RELAY_RATE_WINDOW_MS=60000
# Same-origin Caddy proxy (/keeper/*) needs no CORS; only used for direct access.
KEEPER_CORS_ORIGIN=http://localhost:5173
# Used only by deploy.sh preflight to warn if the keeper wallet holds mainnet ETH.
KEEPER_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
KEEPER_DRY_RUN=false
